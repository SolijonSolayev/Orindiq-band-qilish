rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "solijonsolayev2003@gmail.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Shows
    function isValidShow(data) {
      return data.title is string && data.title.size() <= 100 &&
             data.hall is string && data.hall.size() <= 50 &&
             data.time is string && data.time.size() <= 30 &&
             data.price is number && data.price >= 0 &&
             data.rows is number && data.rows > 0 && data.rows <= 50 &&
             data.cols is number && data.cols > 0 && data.cols <= 50;
    }

    match /shows/{showId} {
      allow get, list: if isValidId(showId);
      allow create, update: if isAdmin() && isValidId(showId) && isValidShow(incoming());
      allow delete: if isAdmin() && isValidId(showId);

      // Seats subcollection
      function isValidSeat(data) {
        return data.seatId is string && data.seatId.size() <= 10 &&
               data.row is string && data.row.size() <= 5 &&
               data.col is number && data.col >= 0 && data.col <= 100 &&
               data.tier is string && data.tier.size() <= 20 &&
               data.status is string && (data.status == "free" || data.status == "held" || data.status == "reserved");
      }

      match /seats/{seatId} {
        allow get, list: if isValidId(showId) && isValidId(seatId);

        // Seat creation: admin or initial sync
        allow create: if isValidId(showId) && isValidId(seatId) && isValidSeat(incoming()) && (
          isAdmin() || (isSignedIn() && incoming().status in ["free", "held", "reserved"])
        );

        // Seat updates (holding, releasing, reserving)
        allow update: if isValidId(showId) && isValidId(seatId) && isSignedIn() && isValidSeat(incoming()) && (
          isAdmin() ||
          // Action 1: Hold a free seat
          (
            existing().status == "free" &&
            incoming().status == "held" &&
            incoming().heldBy == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'heldBy', 'heldExpiresAt', 'updatedAt'])
          ) ||
          // Action 2: Release own held seat
          (
            existing().status == "held" &&
            existing().heldBy == request.auth.uid &&
            incoming().status == "free" &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'heldBy', 'heldExpiresAt', 'updatedAt'])
          ) ||
          // Action 3: Confirm reservation for own held seat
          (
            existing().status == "held" &&
            existing().heldBy == request.auth.uid &&
            incoming().status == "reserved" &&
            incoming().reservedBy == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reservedBy', 'heldBy', 'heldExpiresAt', 'updatedAt'])
          )
        );

        allow delete: if isAdmin() && isValidId(showId) && isValidId(seatId);
      }
    }

    // Reservations
    function isValidReservation(data) {
      return data.reservationId is string && data.reservationId.size() <= 64 &&
             data.showId is string && data.showId.size() <= 64 &&
             data.userId == request.auth.uid &&
             data.seatIds is list && data.seatIds.size() > 0 && data.seatIds.size() <= 20 &&
             data.seatIds[0] is string &&
             data.totalPrice is number && data.totalPrice >= 0 &&
             data.status in ["confirmed", "cancelled"] &&
             data.createdAt is number;
    }

    match /reservations/{reservationId} {
      allow get: if isValidId(reservationId) && isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );

      allow create: if isValidId(reservationId) && isSignedIn() && isValidReservation(incoming()) && (
        incoming().userId == request.auth.uid
      );

      // Updating a reservation (e.g. cancellation)
      allow update: if isValidId(reservationId) && isSignedIn() && isValidReservation(incoming()) && (
        (resource.data.userId == request.auth.uid &&
         incoming().userId == existing().userId &&
         incoming().diff(existing()).affectedKeys().hasOnly(['status'])) ||
        isAdmin()
      );

      allow delete: if isAdmin() && isValidId(reservationId);
    }
  }
}
